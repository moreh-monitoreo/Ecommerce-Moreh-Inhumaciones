PORT=3000
NODE_ENV=production

# URL del frontend en Railway (para CORS)
CORS_ORIGIN=https://tu-app.railway.app

# MySQL (Railway)
# En el servicio desplegado en Railway usa la referencia a la URL interna:
#   DATABASE_URL=${{ MySQL.MYSQL_URL }}
# Para conectarte desde tu máquina usa el proxy público:
#   DATABASE_URL=${{ MySQL.MYSQL_PUBLIC_URL }}
DATABASE_URL=mysql://usuario:password@host:3306/railway

# Alternativa con variables sueltas (se ignora si DATABASE_URL está definida)
DB_HOST=host
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=tu_password
DB_SSL=false

# JWT
JWT_SECRET=un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=7d

# Firebase Storage
FIREBASE_CONFIG={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
